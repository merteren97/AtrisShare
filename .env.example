# Foundation preview: reserved settings, not consumed by the preview CLI yet.
# Future local API must bind to loopback and authenticate desktop/MCP clients.
ATRIS_SHARE_HOST=127.0.0.1
ATRIS_SHARE_PORT=4318
ATRIS_SHARE_DATA_DIR=./data
ATRIS_SHARE_LOG_LEVEL=info
# OAuth application IDs/scopes will be documented per connector when implemented.
# Never put account tokens, provider secrets or real credentials in this file.
