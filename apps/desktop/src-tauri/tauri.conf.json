{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtrisShare",
  "version": "0.1.0-preview.1",
  "identifier": "com.atrishub.share",
  "build": {
    "beforeDevCommand": "npm run dev:native",
    "devUrl": "http://127.0.0.1:1438",
    "beforeBuildCommand": "npm run build && npm run stage:runtime",
    "beforeBundleCommand": "node ../../scripts/package-inventory.mjs --verify src-tauri/runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "AtrisShare", "width": 1260, "height": 830,
      "minWidth": 740, "minHeight": 560, "center": true, "backgroundColor": "#141719"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://img.youtube.com; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "licenseFile": "runtime/LICENSE.txt",
    "resources": { "runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Local social workspace — developer preview",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NDU1RDdCQzQxNjQ0QTAKUldTZ1JCYkVlMTFGV1A1Ym43TW5JZzhtb2xVUndOdGs2T1RXdDJhNXF2cWduckZ3Z2RnMHIxblIK",
      "endpoints": ["https://github.com/merteren97/AtrisShare/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
